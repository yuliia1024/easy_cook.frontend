# Where the dev server proxies `/api` (the Easy Cook backend).
API_PROXY_TARGET=http://localhost:3100
# Base URL the browser calls. Keep `/api` with the dev proxy; set a full URL for a separate host
# (its origin is added to the CSP `connect-src` and must be in the backend's CORS_ORIGINS).
VITE_API_URL=/api
# Google OAuth client ID (type Web application) of the sign-in button; add http://localhost:5173
# (and http://localhost:4173 for `npm run preview`) to its authorized JavaScript origins. The backend checks ID tokens against the same client.
VITE_GOOGLE_CLIENT_ID=
